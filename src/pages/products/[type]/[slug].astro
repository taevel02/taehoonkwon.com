---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { products } from "../../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({ params: { type: product.type, slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
if (!product) return Astro.redirect("/products");
---
<BaseLayout title={`${product.name} · Products`} description={product.description.ko}>
  <a href="/products" class="mb-8 inline-block text-sm text-muted-foreground hover:text-primary">← 모든 제품</a>
  <header class="border-b pb-8">
    <p class="text-xs uppercase text-muted-foreground">{product.type}</p>
    <h1 class="mt-2 text-4xl font-medium">{product.name}</h1>
    <p class="mt-3 leading-relaxed text-muted-foreground">{product.description.ko}</p>
    <div class="mt-6 flex flex-wrap gap-4 text-sm">
      <a href={product.primaryLink.href} class="rounded border px-4 py-2 hover:border-foreground">{product.primaryLink.label.ko}</a>
      {product.secondaryLink && <a href={product.secondaryLink.href} class="rounded border px-4 py-2 hover:border-foreground">{product.secondaryLink.label.ko}</a>}
      {product.support && <a href={`/products/${product.type}/${product.slug}/support`} class="px-1 py-2 text-muted-foreground hover:text-foreground">Support</a>}
      {product.privacy && <a href={`/products/${product.type}/${product.slug}/privacy`} class="px-1 py-2 text-muted-foreground hover:text-foreground">Privacy</a>}
    </div>
  </header>
  <section class="space-y-8 py-8">
    {product.features.map((feature) => (
      <div>
        <h2 class="text-xl font-medium">{feature.title.ko}</h2>
        <p class="mt-2 text-muted-foreground">{feature.description.ko}</p>
      </div>
    ))}
  </section>
  {product.slug === "yeomil-mono" && (
    <section class="space-y-8 border-t pt-8">
      <div>
        <h2 class="text-xl font-medium">서체 체험</h2>
        <div class="mt-4 space-y-4 rounded border p-4">
          <input id="font-sample" class="w-full border-b bg-transparent py-2 outline-none focus:border-primary" placeholder="미리 볼 문장을 입력하세요" />
          <input id="font-size" type="range" min="16" max="72" value="28" class="w-full accent-primary" />
          <output id="font-size-value" class="text-xs text-muted-foreground">28px</output>
          <p id="font-preview" class="break-all font-mono text-3xl" style="font-family: 'Yeomil Mono', monospace">한글과 English, 0123456789</p>
        </div>
      </div>
      <div>
        <h2 class="text-xl font-medium">설치</h2>
        <p class="mt-2 text-sm text-muted-foreground">macOS·Linux 설치 명령</p>
        <div class="mt-3 flex flex-col gap-3 rounded border bg-muted/40 p-4 sm:flex-row sm:items-center">
          <code id="install-command" class="min-w-0 flex-1 overflow-x-auto text-xs sm:text-sm" aria-live="polite">curl -fsSL https://raw.githubusercontent.com/taevel02/yeomil-mono/main/install.sh | bash</code>
          <button id="copy-command" type="button" class="min-h-11 shrink-0 rounded border px-4 text-sm active:scale-[.97]">명령 복사</button>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
{product.slug === "yeomil-mono" && <script is:inline>
  const sample = document.querySelector("#font-sample");
  const size = document.querySelector("#font-size");
  const preview = document.querySelector("#font-preview");
  const sizeValue = document.querySelector("#font-size-value");
  sample?.addEventListener("input", () => { preview.textContent = sample.value || "한글과 English, 0123456789"; });
  size?.addEventListener("input", () => { preview.style.fontSize = `${size.value}px`; sizeValue.textContent = `${size.value}px`; });
  const installCommand = "curl -fsSL https://raw.githubusercontent.com/taevel02/yeomil-mono/main/install.sh | bash";
  document.querySelector("#copy-command")?.addEventListener("click", async () => {
    const code = document.querySelector("#install-command");
    if (!code) return;
    try {
      await navigator.clipboard.writeText(installCommand);
      code.textContent = "복사됨";
      window.setTimeout(() => { code.textContent = installCommand; }, 1600);
    } catch {
      code.textContent = "복사할 수 없습니다";
      window.setTimeout(() => { code.textContent = installCommand; }, 2200);
    }
  });
</script>}
