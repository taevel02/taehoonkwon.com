---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products } from "../../data/products";
---
<BaseLayout title="Products · Taehoon Kwon" description="만들고 운영하는 제품들">
  <header class="mb-8 border-b pb-5">
    <h1 class="text-3xl font-medium">Products</h1>
    <p class="mt-2 text-muted-foreground">만들고 운영하는 제품들</p>
  </header>
  <ul class="divide-y">
    {products.map((product) => (
      <li>
        <a href={`/products/${product.type}/${product.slug}`} class="group block py-6">
          <span class="text-xs uppercase text-muted-foreground">{product.type === "web" ? "Web service" : product.type === "font" ? "Font" : "App"}</span>
          <div class="mt-1 flex items-baseline justify-between gap-4">
            <h2 class="text-xl font-medium group-hover:text-primary">{product.name}</h2>
            <span aria-hidden="true">↗</span>
          </div>
          <p class="mt-2 leading-relaxed text-muted-foreground">{product.tagline.ko}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
