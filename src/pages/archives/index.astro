---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticles, formatDate } from "../../lib/articles";
const articles = await getArticles("archives");
---
<BaseLayout title="Writing · Taehoon Kwon">
  <ul class="animate-fade-in">
    {articles.map((article) => (
      <li class="border-b-[0.1em] py-4 first:pt-0 last:border-0 last:pb-0">
        <a href={`/archives/${article.data.id}`} class="group block">
          <p class="mb-2 text-sm text-primary underline">{article.data.category}</p>
          <h2 class="text-xl group-hover:underline">{article.data.title}</h2>
          {article.data.subtitle && <p class="mb-4 text-sm font-light">{article.data.subtitle}</p>}
          <p class="text-xs text-muted-foreground">{formatDate(article.data.date)}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
